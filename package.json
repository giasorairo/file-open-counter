{
  "name": "file-open-counter",
  "version": "1.0.0",
  "description": "Obsidian plugin that counts how many times each file is opened.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs --production",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "keywords": ["obsidian", "obsidian-plugin"],
  "author": "gia sorairo",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
